{
  "manifest_version": 3,
  "name": "Llave Maestra – Auto-login",
  "version": "1.0.0",
  "description": "Rellena automáticamente los portales del gobierno dominicano con tus credenciales de Llave Maestra.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Llave Maestra"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dgii.gov.do/*",
        "https://oficinavirtual.dgii.gov.do/*",
        "https://dgii.gov.do/*",
        "https://www.tss.gob.do/*",
        "https://tss.gob.do/*",
        "https://suir.gob.do/*",
        "https://ovi.mt.gob.do/*",
        "https://sisaril.mt.gob.do/*",
        "https://virtual.sisalril.gob.do/*",
        "https://www.mt.gob.do/*",
        "https://www.cardnet.com.do/*",
        "https://cardnet.com.do/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.casalabs.com.do/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://app.casalabs.com.do/*"
  ]
}
