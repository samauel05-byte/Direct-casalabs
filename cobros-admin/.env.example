# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor (cron). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cron: Vercel envía "Authorization: Bearer <CRON_SECRET>" automáticamente
CRON_SECRET=una-cadena-larga-aleatoria

# Resend (correo)
RESEND_API_KEY=re_xxx
RESEND_FROM="Mi Empresa <cobros@tudominio.com>"

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Nombre del negocio (variable {{negocio}} y firmas)
BUSINESS_NAME="Mi Empresa"
