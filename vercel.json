{
  "outputDirectory": "public",
  "regions": ["pdx1"],
  "rewrites": [
    { "source": "/api/poll", "destination": "/api/credentials?poll=1" },
    { "source": "/api/logo/:key", "destination": "/api/config?logo=:key" },
    { "source": "/api/nala/:path*", "destination": "/api/nala?route=:path*" },
    { "source": "/api/nomina/:path*", "destination": "/api/nomina?route=:path*" },
    { "source": "/api/monitor/:path*", "destination": "/api/monitor?route=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; connect-src 'self' https://portal-rd-relay.samauel05.workers.dev https://pfsstsdqftgkkakypcux.supabase.co; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/logo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=21600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/nala/jobs/worker", "schedule": "17 6 * * *" },
    { "path": "/api/nomina/cron", "schedule": "0 13 * * *" }
  ]
}
